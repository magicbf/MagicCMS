{
  "key": "roster_squad",
  "title": "Our Team",
  "icon": "🛡️",
  "version": "1.3.0",
  "positions": [
    "left",
    "right"
  ],
  "multiple": true,
  "settings": {
    "group_by": {
      "type": "select",
      "label": "Group members",
      "default": "role",
      "options": {
        "role": "By role",
        "none": "Do not group – one list"
      }
    },
    "view": {
      "type": "select",
      "label": "Look",
      "default": "list",
      "options": {
        "list": "List – avatar, name, position and flag per row",
        "chips": "Chips – most compact, names only"
      }
    },
    "density": {
      "type": "select",
      "label": "Spacing",
      "default": "cozy",
      "options": {
        "cozy": "Comfortable",
        "compact": "Compact – tighter rows"
      }
    },
    "accent": {
      "type": "select",
      "label": "Role colours",
      "default": "roles",
      "options": {
        "roles": "Each role has its own colour (set under Roster → Panel & roles)",
        "theme": "One colour for all roles – the theme's accent"
      }
    },
    "max_per_group": {
      "type": "number",
      "label": "Max. members per role (0 = all)",
      "default": 4
    },
    "count": {
      "type": "number",
      "label": "Max. members in total (0 = all)",
      "default": 12
    },
    "member_sort": {
      "type": "select",
      "label": "Order of the members inside a role",
      "default": "order",
      "options": {
        "order": "As arranged in Roster (▲▼)",
        "name": "Alphabetical"
      }
    },
    "only_roles": {
      "type": "text",
      "label": "Only these roles (comma separated, empty = all)",
      "default": "",
      "help": "Example: Captain, Players, Coach."
    },
    "hide_roles": {
      "type": "text",
      "label": "Hide these roles (comma separated)",
      "default": ""
    },
    "show_photos": {
      "type": "checkbox",
      "label": "Show photos / initials",
      "default": true
    },
    "show_flags": {
      "type": "checkbox",
      "label": "Show country flags",
      "default": true
    },
    "show_counts": {
      "type": "checkbox",
      "label": "Show the number of members next to each role",
      "default": true
    },
    "show_positions": {
      "type": "checkbox",
      "label": "Show each member's position as a pill",
      "default": true
    }
  },
  "note": "Edited under Admin → Roster → Panel & roles."
}