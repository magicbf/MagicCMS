# Uploads must never execute code
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar|php[0-9]|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
AddType text/plain .php .phtml
Header set X-Content-Type-Options "nosniff"
Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'"
